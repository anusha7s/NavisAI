{
  "manifest_version": 3,
  "name": "NavisAI",
  "version": "1.0",
  "description": "Intelligent Autonomous Browser Agent",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "debugger", "tabCapture"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "NavisAI"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_end"
  }]
}